@page
@model NewRazorApp.Pages.Courses.CreateModel
@{ ViewData["Title"] = "Новый курс"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white"><h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Новый курс</h5></div>
            <div class="card-body p-4">
                @if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
                <form method="post">
                    <div class="mb-3"><label class="form-label">Название</label><input class="form-control" name="Title" required /></div>
                    <div class="mb-3"><label class="form-label">Описание</label><textarea class="form-control" name="Description" rows="3"></textarea></div>
                    <div class="mb-3"><label class="form-label">Цена</label><input class="form-control" type="number" step="0.01" name="Price" /></div>
                    <div class="mb-3">
                        <label class="form-label">Уровень</label>
                        <select class="form-select" name="Level">
                            <option value="0">Начинающий</option><option value="1">Средний</option><option value="2">Продвинутый</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Категория</label>
                        <select class="form-select" name="CategoryId" required>
                            <option value="">— Выберите —</option>
                            @foreach (var cat in Model.Categories) { <option value="@cat.Id">@cat.Name</option> }
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark flex-grow-1">Создать</button>
                        <a href="/Courses" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
