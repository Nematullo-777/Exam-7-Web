@page
@model IndexModel
@{ ViewData["Title"] = "Главная"; }

<div class="hero">
    <h1><i class="bi bi-mortarboard-fill me-2"></i>Платформа онлайн-курсов</h1>
    <p class="lead">Учись у лучших преподавателей, развивайся и достигай новых высот</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="/Courses" class="btn btn-primary btn-lg">
            <i class="bi bi-book"></i> Все курсы
        </a>
        @if (HttpContext.Session.GetString("jwt") == null)
        {
            <a href="/Auth/Register" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-person-plus"></i> Начать бесплатно
            </a>
        }
    </div>
</div>

@{
    var published = Model.Courses.Where(x => x.IsPublished).Take(6).ToList();
}

@if (published.Any())
{
    <div class="page-header">
        <div>
            <h2>Популярные курсы</h2>
            <div class="page-title-sub">Выбраны редакцией платформы</div>
        </div>
        <a href="/Courses" class="btn btn-outline-primary btn-sm">
            Все курсы <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var c in published)
        {
            <div class="col-md-4 animate-fade-up">
                <div class="card h-100">
                    <div class="course-thumb-placeholder">
                        <i class="bi bi-book"></i>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex gap-1 mb-2">
                            <span class="badge bg-primary">@c.Level</span>
                            <span class="badge bg-secondary">@c.CategoryName</span>
                        </div>
                        <h5 class="card-title fw-700">@c.Title</h5>
                        <p class="text-muted small flex-grow-1">
                            @(c.Description?.Length > 90 ? c.Description[..90] + "…" : c.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
                            <span class="fw-700 text-brand" style="font-size:1.1rem">@c.Price.ToString("C")</span>
                            <span class="d-flex align-items-center gap-1" style="color:#f59e0b;font-weight:600">
                                <i class="bi bi-star-fill"></i> @c.AverageRating.ToString("F1")
                            </span>
                        </div>
                        <a href="/Courses/Details?id=@c.Id" class="btn btn-outline-primary w-100">
                            Подробнее <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-journal-x"></i>
        <p>Курсы пока не добавлены</p>
    </div>
}
