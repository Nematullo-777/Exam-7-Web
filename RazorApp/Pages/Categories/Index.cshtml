@page
@model NewRazorApp.Pages.Categories.IndexModel
@{ ViewData["Title"] = "Категории"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-tags me-2"></i>Категории</h2>
    @if (Model.HttpContext.Session.GetString("jwt") != null)
    {
        <a href="/Categories/Create" class="btn btn-dark"><i class="bi bi-plus-circle me-1"></i>Добавить</a>
    }
</div>

<div class="row g-3">
    @foreach (var cat in Model.Categories)
    {
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="bg-dark bg-opacity-10 rounded-circle p-2"><i class="bi bi-tag-fill"></i></div>
                        <h5 class="mb-0">@cat.Name</h5>
                    </div>
                    @if (!string.IsNullOrEmpty(cat.Description)) { <p class="text-muted small">@cat.Description</p> }
                </div>
                @if (Model.HttpContext.Session.GetString("jwt") != null)
                {
                    <div class="card-footer bg-transparent">
                        <form method="post" onsubmit="return confirm('Удалить?')">
                            <input type="hidden" name="id" value="@cat.Id" />
                            <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash me-1"></i>Удалить</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</div>
