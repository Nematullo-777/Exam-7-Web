@page
@model NewRazorApp.Pages.Categories.CreateModel
@{ ViewData["Title"] = "Новая категория"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white"><h5 class="mb-0"><i class="bi bi-tag me-2"></i>Новая категория</h5></div>
            <div class="card-body p-4">
                @if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
                <form method="post">
                    <div class="mb-3"><label class="form-label">Название</label><input class="form-control" name="Name" required /></div>
                    <div class="mb-3"><label class="form-label">Описание</label><textarea class="form-control" name="Description" rows="3"></textarea></div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark flex-grow-1">Создать</button>
                        <a href="/Categories" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
