@page
@model NewRazorApp.Pages.Auth.LoginModel
@{ ViewData["Title"] = "Вход"; }

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon"><i class="bi bi-box-arrow-in-right"></i></div>
            <h4>Добро пожаловать</h4>
            <p class="text-muted small mb-0">Войдите в свой аккаунт</p>
        </div>
        <div class="auth-body">
            @if (Model.Error != null)
            {
                <div class="alert alert-danger mb-4">
                    <i class="bi bi-exclamation-circle"></i> @Model.Error
                </div>
            }
            <form method="post">
                <div class="mb-4">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" name="email" placeholder="you@example.com" />
                </div>
                <div class="mb-4">
                    <label class="form-label">Пароль</label>
                    <input class="form-control" type="password" name="password" placeholder="••••••••" />
                </div>
                <button type="submit" class="btn btn-primary w-100" style="justify-content:center;padding:.7rem">
                    <i class="bi bi-box-arrow-in-right"></i> Войти
                </button>
            </form>
        </div>
        <div class="auth-footer">
            Нет аккаунта? <a href="/Auth/Register">Зарегистрироваться</a>
        </div>
    </div>
</div>
