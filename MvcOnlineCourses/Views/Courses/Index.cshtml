@model List<CourseDto>
@{ ViewData["Title"] = "Курсы"; }

<div class="page-header">
    <div>
        <h2><i class="bi bi-book me-2 text-brand"></i>Все курсы</h2>
        <div class="page-title-sub">Найдено курсов: @Model.Count</div>
    </div>
    @if (Context.Session.GetString("jwt") != null)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Добавить курс
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-journal-x"></i>
        <p>Курсы пока не добавлены</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-4 animate-fade-up">
                <div class="card h-100 @(c.IsPublished ? "" : "opacity-75")">
                    @if (!string.IsNullOrEmpty(c.ThumbnailPath))
                    {
                        <img src="@c.ThumbnailPath" class="card-img-top" alt="@c.Title" />
                    }
                    else
                    {
                        <div class="course-thumb-placeholder">
                            <i class="bi bi-book"></i>
                        </div>
                    }
                    <div class="card-body">
                        <div class="d-flex gap-1 mb-2 flex-wrap">
                            <span class="badge bg-primary">@c.Level</span>
                            <span class="badge bg-secondary">@c.CategoryName</span>
                            @if (!c.IsPublished)
                            {
                                <span class="status-pill draft"><i class="bi bi-pencil"></i> Черновик</span>
                            }
                            else
                            {
                                <span class="status-pill published"><i class="bi bi-check-circle"></i> Опубликован</span>
                            }
                        </div>
                        <h6 class="fw-700 mb-1">@c.Title</h6>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-person me-1"></i>@c.InstructorName
                        </p>
                        <div class="d-flex justify-content-between text-muted small">
                            <span><i class="bi bi-collection me-1"></i>@c.LessonCount урок(ов)</span>
                            <span style="color:#f59e0b;font-weight:600">
                                <i class="bi bi-star-fill me-1"></i>@c.AverageRating.ToString("F1")
                            </span>
                        </div>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm flex-grow-1">
                            <i class="bi bi-eye"></i> Детали
                        </a>
                        @if (Context.Session.GetString("jwt") != null)
                        {
                            <form asp-action="TogglePublish" method="post" class="m-0">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button class="btn btn-sm @(c.IsPublished ? "btn-outline-warning" : "btn-outline-success")"
                                        title="@(c.IsPublished ? "Снять с публикации" : "Опубликовать")">
                                    <i class="bi @(c.IsPublished ? "bi-eye-slash" : "bi-check-circle")"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Удалить курс «@c.Title»?')" class="m-0">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
