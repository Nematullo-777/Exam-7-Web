@model List<Application.DTOs.CourseDTOs.CourseDto>

@{
    ViewData["Title"] = "Курсы";

    var categories = ViewBag.Categories as List<Application.DTOs.CategoryDTOs.CategoryDto> ?? new();
    var selectedCategory = ViewBag.CategoryId?.ToString();
    var selectedSort = ViewBag.Sort?.ToString();
}

<div class="main-content-wrapper">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 style="font-weight: 700;">Курсы</h2>
            <p>@Model.Count курсов в базе</p>
        </div>
    </div>

    <!-- 🔍 ФИЛЬТРЫ -->
    <form method="get" class="mb-4">
        <div class="row g-2">

            <!-- Поиск -->
            <div class="col-md-4">
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Поиск..." />
            </div>

            <!-- Категория -->
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">Все категории</option>

                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id"
                                selected="@(selectedCategory == cat.Id.ToString())">
                            @cat.Name
                        </option>
                    }
                </select>
            </div>

            <!-- Сортировка -->
            <div class="col-md-3">
                <select name="sort" class="form-select">
                    <option value="">Без сортировки</option>

                    <option value="asc"
                            selected="@(selectedSort == "asc")">
                        По возрастанию
                    </option>

                    <option value="desc"
                            selected="@(selectedSort == "desc")">
                        По убыванию
                    </option>
                </select>
            </div>

            <!-- Кнопка -->
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100">
                    Найти
                </button>
            </div>

        </div>
    </form>

    <!-- 📦 КУРСЫ -->
    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">

                    @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                    {
                        <img src="@course.ThumbnailPath" class="card-img-top" />
                    }

                    <div class="card-body">
                        <h5>@course.Title</h5>
                        <p>@course.CategoryName</p>

                        <p>
                            ⭐ @course.AverageRating |
                            👨‍🎓 @course.EnrollmentCount
                        </p>

                        <p><b>$@course.Price</b></p>

                        <a asp-controller="Lessons"
                           asp-action="Index"
                           asp-route-courseId="@course.Id"
                           class="btn btn-primary w-100">
                            Уроки
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

</div>