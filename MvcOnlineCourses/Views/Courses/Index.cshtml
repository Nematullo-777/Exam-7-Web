@model List<Application.DTOs.CourseDTOs.CourseDto>

@{
    ViewData["Title"] = "Курсы";

    var categories = ViewBag.Categories as SelectList; // Изменено на SelectList для удобства
    var selectedCategory = ViewBag.CategoryId?.ToString();
    var selectedSort = ViewBag.Sort?.ToString();
}

<div class="main-content-wrapper">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 style="font-weight: 700;">Курсы</h2>
            <p class="text-muted">@Model.Count курсов в базе</p>
        </div>

        <a asp-controller="Courses" asp-action="Create" class="btn btn-primary px-4 shadow-sm d-flex align-items-center">
            <i class="bi bi-plus-lg me-2"></i> Создать курс
        </a>
    </div>

    <form method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-4">
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Поиск..." />
            </div>

            <div class="col-md-3">
                <select name="categoryId" asp-items="categories" class="form-select">
                    <option value="">Все категории</option>
                </select>
            </div>

            <div class="col-md-3">
                <select name="sort" class="form-select">
                    <option value="">Без сортировки</option>
                    <option value="asc" selected="@(selectedSort == "asc")">По возрастанию</option>
                    <option value="desc" selected="@(selectedSort == "desc")">По убыванию</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100">Найти</button>
            </div>
        </div>
    </form>

    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                    {
                        <img src="@course.ThumbnailPath" class="card-img-top" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="fw-bold">@course.Title</h5>
                        <p class="text-muted small">@course.CategoryName</p>

                        <p>
                            ⭐ @course.AverageRating |
                            👨‍🎓 @course.EnrollmentCount
                        </p>

                        <p class="fs-5"><b>$@course.Price</b></p>

                        <div class="d-flex gap-2">
                            <a asp-controller="Lessons"
                               asp-action="Index"
                               asp-route-courseId="@course.Id"
                               class="btn btn-outline-primary flex-grow-1">
                                Уроки
                            </a>
        
                            <a asp-controller="Courses"
                               asp-action="Edit"
                               asp-route-id="@course.Id"
                               class="btn btn-warning flex-grow-1 text-white">
                                <i class="bi bi-pencil-square"></i> Изменить
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>