@model CreateCourseDto
@{ ViewData["Title"] = "Создать курс"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Новый курс</h5>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Название *</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">Цена</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Level" class="form-label">Уровень</label>
                        <select asp-for="Level" class="form-select">
                            <option value="0">Начинающий</option>
                            <option value="1">Средний</option>
                            <option value="2">Продвинутый</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label">Категория *</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">— Выберите —</option>
                            @foreach (var cat in (ViewBag.Categories as List<CategoryDto> ?? new()))
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">Создать</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
