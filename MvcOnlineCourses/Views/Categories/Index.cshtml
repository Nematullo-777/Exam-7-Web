@model List<CategoryDto>
@{ ViewData["Title"] = "Категории"; }

<div class="page-header">
    <div>
        <h2><i class="bi bi-tags me-2 text-brand"></i>Категории</h2>
        <div class="page-title-sub">@Model.Count категорий на платформе</div>
    </div>
    @if (Context.Session.GetString("jwt") != null)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Добавить
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-tags"></i>
        <p>Категории не добавлены</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var cat in Model)
        {
            <div class="col-md-4 animate-fade-up">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-start gap-3">
                        <div class="cat-icon">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-700 mb-1">@cat.Name</h5>
                            @if (!string.IsNullOrEmpty(cat.Description))
                            {
                                <p class="text-muted small mb-0">@cat.Description</p>
                            }
                        </div>
                    </div>
                    @if (Context.Session.GetString("jwt") != null)
                    {
                        <div class="card-footer">
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Удалить категорию «@cat.Name»?')">
                                <input type="hidden" name="id" value="@cat.Id" />
                                <button class="btn btn-sm btn-outline-danger w-100">
                                    <i class="bi bi-trash"></i> Удалить
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
