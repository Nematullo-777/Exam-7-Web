@{
    ViewData["Title"] = "Dashboard";
    var summary = ViewBag.Summary as Application.DTOs.DashboardSummaryDto;
    var topCourses = ViewBag.TopCourses as List<Application.DTOs.TopCourseDto>;
}

<div class="main-content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 style="font-weight: 700; color: #000; margin: 0; font-size: 28px;">Dashboard</h2>
            <p style="color: #9197b3; font-size: 14px; margin-top: 5px;">Добро пожаловать в EduPortal</p>
        </div>
    </div>

    @if (summary != null)
    {
        <div class="row g-4 mb-5">
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background: #ede9fe; color: #5932ea;">
                        <i class="bi bi-collection-play-fill"></i>
                    </div>
                    <div class="stat-value">@summary.TotalCourses</div>
                    <div class="stat-label">Курсов</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background: #dcfce7; color: #16a34a;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="stat-value">@summary.TotalStudents</div>
                    <div class="stat-label">Студентов</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background: #fef9c3; color: #ca8a04;">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <div class="stat-value">@summary.TotalEnrollments</div>
                    <div class="stat-label">Записей</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background: #fee2e2; color: #dc2626;">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <div class="stat-value">@summary.TotalRevenue.ToString("N0")</div>
                    <div class="stat-label">Выручка ($)</div>
                </div>
            </div>
        </div>
    }

    @if (topCourses != null && topCourses.Any())
    {
        <h5 style="font-weight: 700; color: #111827; margin-bottom: 16px;">Топ курсов по записям</h5>
        <div class="table-card">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Курс</th>
                        <th>Инструктор</th>
                        <th>Записей</th>
                        <th>Выручка</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in topCourses)
                    {
                        <tr>
                            <td><strong>@c.Title</strong></td>
                            <td><span class="text-muted">@c.InstructorName</span></td>
                            <td><span class="badge-count">@c.EnrollmentCount</span></td>
                            <td><strong>$@c.Revenue.ToString("N0")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
