@model RegisterDto
@{ ViewData["Title"] = "Регистрация"; }

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon" style="background:var(--success)"><i class="bi bi-person-plus"></i></div>
            <h4>Создать аккаунт</h4>
            <p class="text-muted small mb-0">Присоединяйтесь к платформе</p>
        </div>
        <div class="auth-body">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mb-4">
                    <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                </div>
            }
            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label">Полное имя</label>
                    <input asp-for="FullName" class="form-control" placeholder="Иван Иванов" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Имя пользователя</label>
                    <input asp-for="UserName" class="form-control" placeholder="ivan_ivanov" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Минимум 6 символов" />
                </div>
                <div class="mb-4">
                    <label class="form-label">Подтвердите пароль</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Повторите пароль" />
                </div>
                <button type="submit" class="btn btn-success w-100" style="justify-content:center;padding:.7rem">
                    <i class="bi bi-person-check"></i> Создать аккаунт
                </button>
            </form>
        </div>
        <div class="auth-footer">
            Уже есть аккаунт?
            <a asp-controller="Auth" asp-action="Login">Войти</a>
        </div>
    </div>
</div>
