@model MvcOnlineCourses.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Вход";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Вход — EduPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background: #f5f7fb; font-family: 'Poppins', sans-serif; }
        .login-card { max-width: 420px; margin: 80px auto; background: #fff; border-radius: 24px; padding: 40px; box-shadow: 0 10px 40px rgba(89,50,234,0.08); border: 1px solid #f0f0f0; }
        .logo { color: #5932ea; font-weight: 700; font-size: 22px; text-align: center; margin-bottom: 8px; }
        .subtitle { color: #9197b3; font-size: 13px; text-align: center; margin-bottom: 32px; }
        .form-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #9197b3; }
        .form-control { background: #f9f9fb; border: 1px solid #f0f0f0; border-radius: 12px; padding: 12px 15px; font-size: 14px; }
        .form-control:focus { border-color: #5932ea; box-shadow: 0 0 0 4px rgba(89,50,234,0.1); background: #fff; }
        .btn-login { background: #5932ea; color: #fff; border: none; border-radius: 12px; padding: 14px; font-size: 14px; font-weight: 600; width: 100%; transition: all 0.3s; }
        .btn-login:hover { background: #4a28c7; transform: translateY(-1px); }
        .link-register { color: #5932ea; font-size: 13px; text-align: center; display: block; margin-top: 20px; text-decoration: none; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo"><i class="bi bi-mortarboard-fill me-2"></i>EduPortal</div>
        <div class="subtitle">Войдите в свой аккаунт</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger rounded-3 py-2 mb-3" style="font-size: 13px;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="your@email.com" />
            </div>
            <div class="mb-4">
                <label class="form-label">Пароль</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••" />
            </div>
            <button type="submit" class="btn-login">Войти</button>
        </form>
        <a asp-controller="Account" asp-action="Register" class="link-register">Нет аккаунта? Зарегистрироваться</a>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
