@model List<Application.DTOs.StudentDTOs.StudentDto>
@{
    ViewData["Title"] = "Студенты";
}

<div class="main-content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 style="font-weight: 700; color: #000; margin: 0; font-size: 28px;">Студенты</h2>
            <p style="color: #9197b3; font-size: 14px; margin-top: 5px;">@Model.Count студентов</p>
        </div>
    </div>

    <div class="table-card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Имя</th>
                    <th>Email</th>
                    <th>Записей</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle me-3">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div>
                                    <strong>@s.FullName</strong>
                                    @if (!string.IsNullOrEmpty(s.Bio))
                                    {
                                        <div class="text-muted" style="font-size: 12px;">@s.Bio</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td><span class="text-muted">@s.Email</span></td>
                        <td><span class="badge-count">@s.EnrollmentCount</span></td>
                        <td>
                            <form asp-controller="Students" asp-action="Delete" asp-route-id="@s.Id" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete-custom" style="padding: 6px 16px;" onclick="return confirm('Удалить студента?')">
                                    Удалить
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4 gap-2">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i"
                   class="@(i == (int)ViewBag.CurrentPage ? "btn-dark-custom" : "btn-edit-custom")"
                   style="padding: 8px 16px; display: inline-block; text-align: center;">@i</a>
            }
        </div>
    }
</div>
