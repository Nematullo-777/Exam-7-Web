<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineCourses</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <aside class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 sidebar-container">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-4 text-white min-vh-100">

                    <a href="/" class="d-flex align-items-center pb-5 mb-md-0 me-md-auto text-decoration-none logo-text">
                        <i class="bi bi-mortarboard-fill me-2" style="font-size: 1.5rem;"></i>
                        <span class="fs-4 d-none d-sm-inline">EduPortal <small style="font-size: 10px; color: #9197b3;">v.01</small></span>
                    </a>

                    <ul class="nav nav-pills flex-column mb-auto w-100" id="menu">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index"
                               class="nav-link align-middle px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                                <i class="bi bi-speedometer2"></i>
                                <span class="ms-1 d-none d-sm-inline">Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Courses" asp-action="Index"
                               class="nav-link px-3 align-middle @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Courses" ? "active" : "")">
                                <i class="bi bi-collection-play"></i>
                                <span class="ms-1 d-none d-sm-inline">Курсы</span>
                                <i class="bi bi-chevron-right float-end d-none d-sm-inline mt-1" style="font-size: 12px;"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Students" asp-action="Index"
                               class="nav-link px-3 align-middle @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Students" ? "active" : "")">
                                <i class="bi bi-people"></i>
                                <span class="ms-1 d-none d-sm-inline">Студенты</span>
                                <i class="bi bi-chevron-right float-end d-none d-sm-inline mt-1" style="font-size: 12px;"></i>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Categories" asp-action="Index"
                               class="nav-link px-3 align-middle @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")">
                                <i class="bi bi-tags"></i>
                                <span class="ms-1 d-none d-sm-inline">Категории</span>
                                <i class="bi bi-chevron-right float-end d-none d-sm-inline mt-1" style="font-size: 12px;"></i>
                            </a>
                        </li>
                    </ul>

                    <hr class="w-100" style="color: #eee;" />
                    <div class="pb-4 w-100">
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle me-2 d-none d-sm-inline-flex">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div class="d-none d-sm-inline">
                                <div class="fw-bold" style="font-size: 14px; color: #000;">
                                    @User.Identity?.Name
                                </div>
                                <div class="text-muted" style="font-size: 12px;">
                                    @(User.IsInRole("Admin") ? "Администратор" : User.IsInRole("Instructor") ? "Инструктор" : "Студент")
                                </div>
                            </div>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100 d-none d-sm-block">
                                <i class="bi bi-box-arrow-right me-1"></i>Выйти
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <main class="col p-0 main-content-wrapper">
                <div class="p-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
