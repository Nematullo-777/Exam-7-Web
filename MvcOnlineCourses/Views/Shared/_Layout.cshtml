<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — OnlineCourses</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-mortarboard-fill"></i>
            OnlineCourses<span class="brand-dot"></span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Courses" asp-action="Index">
                        <i class="bi bi-book"></i> Курсы
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-tags"></i> Категории
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav align-items-center gap-1">
                @{
                    var jwt  = Context.Session.GetString("jwt");
                    var name = Context.Session.GetString("userName");
                    var role = Context.Session.GetString("role");
                }
                @if (jwt != null)
                {
                    <li class="nav-item">
                        <span class="nav-user-info">
                            <i class="bi bi-person-circle"></i>
                            <span>@name</span>
                            <span class="badge bg-primary" style="font-size:.68rem">@role</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="nav-link btn-nav-login border-0 bg-transparent">
                                <i class="bi bi-box-arrow-right"></i> Выход
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link btn-nav-login" asp-controller="Auth" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Войти
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn-nav-register" asp-controller="Auth" asp-action="Register">
                            <i class="bi bi-person-plus"></i> Регистрация
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4">
            <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
        </div>
    }
    @RenderBody()
</main>

<footer>
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-mortarboard-fill me-1" style="color:var(--brand)"></i> OnlineCourses &copy; 2026</span>
        <span class="d-flex gap-3">
            <a href="#">О платформе</a>
            <a href="#">Помощь</a>
        </span>
    </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
