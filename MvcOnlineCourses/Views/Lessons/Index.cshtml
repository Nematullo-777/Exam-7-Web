@model List<Application.DTOs.LessonDTOs.LessonDto>
@{
    ViewData["Title"] = "Уроки";
    var course = ViewBag.Course as Application.DTOs.CourseDTOs.CourseDto;
}

<div class="main-content-wrapper">
    <div class="mb-4">
        <a asp-controller="Courses" asp-action="Index" class="btn-edit-custom" style="display: inline-flex; align-items: center;">
            <i class="bi bi-arrow-left me-2"></i>Назад к курсам
        </a>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 style="font-weight: 700; color: #000; margin: 0; font-size: 28px;">Уроки курса</h2>
            @if (course != null)
            {
                <p style="color: #9197b3; font-size: 14px; margin-top: 5px;">@course.Title — @Model.Count уроков</p>
            }
        </div>
        @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
        {
            <button type="button" class="btn-dark-custom shadow-sm" data-bs-toggle="modal" data-bs-target="#createLessonModal">
                <span style="font-size: 18px; margin-right: 8px;">+</span> Добавить урок
            </button>
        }
    </div>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 60px; color: #9197b3;">
            <i class="bi bi-journal-x" style="font-size: 3rem;"></i>
            <p class="mt-3">Уроки пока не добавлены</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Название</th>
                        <th>Длительность</th>
                        <th>Видео</th>
                        @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                        {
                            <th>Действия</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lesson in Model.OrderBy(l => l.Order))
                    {
                        <tr>
                            <td><span class="badge-count">@lesson.Order</span></td>
                            <td><strong>@lesson.Title</strong></td>
                            <td><span class="text-muted">@lesson.DurationMinutes мин.</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                                {
                                    <a href="@lesson.VideoUrl" target="_blank" class="btn-edit-custom" style="display: inline-block; padding: 4px 12px; font-size: 12px;">
                                        <i class="bi bi-play-circle me-1"></i>Смотреть
                                    </a>
                                }
                                else
                                {
                                    <span style="color: #d1d5db; font-size: 12px;">Нет видео</span>
                                }
                            </td>
                            @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                            {
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Lessons" asp-action="Edit" asp-route-id="@lesson.Id" 
                                           class="btn-edit-custom" style="padding: 4px 12px; font-size: 12px; text-decoration: none;">
                                            Изменить
                                        </a>

                                        <form asp-controller="Lessons" asp-action="Delete" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@lesson.Id" />
                                            <input type="hidden" name="courseId" value="@lesson.CourseId" />
                                            <button type="submit" class="btn-delete-custom" style="padding: 4px 12px; font-size: 12px;" onclick="return confirm('Удалить урок?')">
                                                Удалить
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
{
<div class="modal fade" id="createLessonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 24px; border: none;">
            <div class="modal-header" style="border-bottom: 1px solid #f0f0f0; padding: 24px;">
                <h5 class="modal-title" style="font-weight: 700;">Добавить урок</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <form asp-controller="Lessons" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CourseId" value="@course?.Id" />
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Название урока</label>
                        <input name="Title" class="form-control custom-input" placeholder="Введение в тему" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Содержание</label>
                        <textarea name="Content" class="form-control custom-input" rows="3" placeholder="Текст урока" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Ссылка на видео</label>
                        <input name="VideoUrl" class="form-control custom-input" placeholder="https://youtube.com/..." />
                    </div>
                    <div class="row mb-4">
                        <div class="col">
                            <label class="form-label small text-muted text-uppercase fw-bold">Порядок</label>
                            <input name="Order" type="number" class="form-control custom-input" value="1" min="1" />
                        </div>
                        <div class="col">
                            <label class="form-label small text-muted text-uppercase fw-bold">Длительность (мин)</label>
                            <input name="DurationMinutes" type="number" class="form-control custom-input" value="30" min="1" />
                        </div>
                    </div>
                    <button type="submit" class="btn-dark-custom w-100" style="justify-content: center; padding: 14px;">Добавить урок</button>
                </form>
            </div>
        </div>
    </div>
</div>
}
