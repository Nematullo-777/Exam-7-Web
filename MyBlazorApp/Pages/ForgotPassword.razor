@page "/forgot-password"
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Восстановление пароля</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <i class="bi bi-key-fill"></i>
            <h2>Восстановление пароля</h2>
            @if (_step == 1) { <p>Введите email — отправим код подтверждения</p> }
            @if (_step == 2) { <p>Код отправлен на <strong>@_email</strong></p> }
            @if (_step == 3) { <p>Код подтверждён — задайте новый пароль</p> }
        </div>

        @if (_error != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-circle"></i> @_error
            </div>
        }

        @* ШАГ 1 — ввод email *@
        @if (_step == 1)
        {
            <div class="form-group">
                <label class="form-label">Email</label>
                <input class="form-control" type="email" @bind="_email" placeholder="you@example.com" />
            </div>
            <button class="btn btn-primary w-100" @onclick="DoSendEmail" disabled="@_loading" style="margin-top:8px">
                @if (_loading) { <div class="spinner" style="width:16px;height:16px;border-width:2px"></div> }
                Отправить код
            </button>
        }

        @* ШАГ 2 — ввод кода *@
        @if (_step == 2)
        {
            <div class="alert alert-success">
                <i class="bi bi-envelope-check"></i>
                Код отправлен на @_email. Проверьте почту.
            </div>
            <div class="form-group">
                <label class="form-label">Код из письма</label>
                <input class="form-control" @bind="_code" placeholder="123456" maxlength="10" />
            </div>
            <button class="btn btn-primary w-100" @onclick="DoVerifyCode" disabled="@_loading" style="margin-top:8px">
                @if (_loading) { <div class="spinner" style="width:16px;height:16px;border-width:2px"></div> }
                Подтвердить код
            </button>
            <button class="btn btn-secondary w-100" @onclick="() => { _step = 1; _error = null; }" style="margin-top:8px">
                Назад
            </button>
        }

        @* ШАГ 3 — новый пароль *@
        @if (_step == 3)
        {
            <div class="form-group">
                <label class="form-label">Новый пароль</label>
                <input class="form-control" type="password" @bind="_newPassword" placeholder="Минимум 6 символов" />
            </div>
            <div class="form-group">
                <label class="form-label">Повторите пароль</label>
                <input class="form-control" type="password" @bind="_confirmPassword" placeholder="••••••••" />
            </div>
            <button class="btn btn-primary w-100" @onclick="DoReset" disabled="@_loading" style="margin-top:8px">
                @if (_loading) { <div class="spinner" style="width:16px;height:16px;border-width:2px"></div> }
                Сменить пароль
            </button>
        }

        <div class="divider"></div>
        <div style="text-align:center;font-size:0.875rem;color:var(--text-muted)">
            <a href="/login">← Вернуться ко входу</a>
        </div>
    </div>
</div>

@code {
    int _step = 1;
    string? _email = "";
    string _code = "", _newPassword = "", _confirmPassword = "";
    string? _error;
    bool _loading;

    // Шаг 1: отправить код на email → POST api/Auth/send-email
    async Task DoSendEmail()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _error = "Введите email";
            return;
        }

        _loading = true;
        _error = null;

        var (ok, err) = await Api.SendEmailAsync(new SendEmailDto
        {
            Email = _email
        });

        if (ok)
            _step = 2;
        else
            _error = err ?? "Не удалось отправить код";

        _loading = false;
    }

    // Шаг 2: проверить код → POST api/Auth/verify-code
    async Task DoVerifyCode()
    {
        if (string.IsNullOrWhiteSpace(_code))
        {
            _error = "Введите код";
            return;
        }

        _loading = true;
        _error = null;

        var (ok, err) = await Api.VerifyCodeAsync(new VerifyCodeDto
        {
            Email = _email!,
            Code = _code
        });

        if (ok)
            _step = 3;
        else
            _error = err ?? "Неверный код";

        _loading = false;
    }

    // Шаг 3: сбросить пароль → POST api/Auth/reset-password
    async Task DoReset()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _error = "Введите пароль";
            return;
        }

        if (_newPassword.Length < 6)
        {
            _error = "Минимум 6 символов";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _error = "Пароли не совпадают";
            return;
        }

        _loading = true;
        _error = null;

        var (ok, err) = await Api.ResetPasswordAsync(new ResetPasswordDto
        {
            Email = _email!,
            NewPassword = _newPassword,
            ConfirmPassword = _confirmPassword
        });

        if (ok)
        {
            Nav.NavigateTo("/login");
        }
        else
        {
            _error = err ?? "Ошибка сброса пароля";
            _loading = false;
        }
    }
}
