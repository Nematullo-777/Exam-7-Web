@page "/admin"
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Дашборд — Admin</PageTitle>

@if (!Api.IsAdmin) { Nav.NavigateTo("/"); return; }

<div class="grid grid-4 mb-3">
    <div class="card stat-card">
        <div class="stat-icon" style="background:rgba(108,99,255,0.15);color:var(--primary)"><i class="bi bi-journals"></i></div>
        <div class="stat-info"><div class="stat-value">@_courses.Count</div><div class="stat-label">Всего курсов</div></div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon" style="background:rgba(34,197,94,0.15);color:var(--success)"><i class="bi bi-check-circle-fill"></i></div>
        <div class="stat-info"><div class="stat-value">@_courses.Count(x => x.IsPublished)</div><div class="stat-label">Опубликовано</div></div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon" style="background:rgba(59,130,246,0.15);color:var(--info)"><i class="bi bi-tags-fill"></i></div>
        <div class="stat-info"><div class="stat-value">@_cats.Count</div><div class="stat-label">Категорий</div></div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:var(--warning)"><i class="bi bi-people-fill"></i></div>
        <div class="stat-info"><div class="stat-value">@_users.Count</div><div class="stat-label">Пользователей</div></div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
    <div>
        <div class="page-header"><h2>Последние курсы</h2><a href="/admin/courses" class="btn btn-secondary btn-sm">Все</a></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Название</th><th>Инструктор</th><th>Статус</th></tr></thead>
                <tbody>
                    @foreach (var c in _courses.OrderByDescending(x => x.CreatedAt).Take(5))
                    {
                        <tr>
                            <td><div class="fw-600 fs-sm">@c.Title</div></td>
                            <td class="text-muted fs-sm">@c.InstructorName</td>
                            <td><span class="badge @(c.IsPublished ? "badge-success" : "badge-warning")">@(c.IsPublished ? "Опубликован" : "Черновик")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div>
        <div class="page-header"><h2>Пользователи</h2><a href="/admin/users" class="btn btn-secondary btn-sm">Все</a></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Имя</th><th>Роль</th></tr></thead>
                <tbody>
                    @foreach (var u in _users.Take(5))
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-center gap-2">
                                    <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--secondary));display:flex;align-items:center;justify-content:center;color:white;font-size:0.7rem;font-weight:700">@u.FullName.FirstOrDefault()</div>
                                    <div class="fw-600 fs-sm">@u.FullName</div>
                                </div>
                            </td>
                            <td><span class="badge @RoleBadge(u.Role)">@u.Role</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {

    List<GetCourseDto> _courses = new();

    List<GetCategoryDto> _cats = new();

    List<GetStudentDto> _users = new();

    protected override async Task OnInitializedAsync()
    {
        var t1 = Api.GetCoursesAsync();
        var t2 = Api.GetCategoriesAsync();
        var t3 = Api.GetStudentsAsync();

        await Task.WhenAll(t1, t2, t3);

        _courses = t1.Result?.Data ?? new List<GetCourseDto>();

        _cats = t2.Result?.Data ?? new List<GetCategoryDto>();

        _users = t3.Result?.Data ?? new List<GetStudentDto>();
    }

    static string RoleBadge(string r) => r switch
    {
        "Admin" => "badge-danger",
        "Instructor" => "badge-info",
        "Student" => "badge-secondary",
        _ => "badge-secondary"
    };
}
