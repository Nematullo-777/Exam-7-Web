@page "/instructor/stats"
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Статистика — Инструктор</PageTitle>

@if (!Api.IsInstructor) { Nav.NavigateTo("/"); return; }

<div class="grid grid-4 mb-3">
    <div class="card stat-card">
        <div class="stat-icon" style="background:rgba(108,99,255,0.15);color:var(--primary)"><i class="bi bi-book-fill"></i></div>
        <div class="stat-info"><div class="stat-value">@_courses.Count</div><div class="stat-label">Всего курсов</div></div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon" style="background:rgba(34,197,94,0.15);color:var(--success)"><i class="bi bi-eye-fill"></i></div>
        <div class="stat-info"><div class="stat-value">@_courses.Count(x=>x.IsPublished)</div><div class="stat-label">Опубликовано</div></div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:var(--warning)"><i class="bi bi-star-fill"></i></div>
        <div class="stat-info"><div class="stat-value">@(_courses.Any() ? _courses.Average(x=>x.AverageRating).ToString("F1") : "—")</div><div class="stat-label">Средний рейтинг</div></div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon" style="background:rgba(239,68,68,0.15);color:var(--danger)"><i class="bi bi-currency-dollar"></i></div>
        <div class="stat-info"><div class="stat-value">@_courses.Sum(x=>x.Price).ToString("C0")</div><div class="stat-label">Сумма цен</div></div>
    </div>
</div>

@if (_loading) { <div class="loading-center"><div class="spinner"></div></div> }
else
{
    <div class="page-header"><h2>Детали курсов</h2></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Курс</th><th>Уроки</th><th>Рейтинг</th><th>Цена</th><th>Статус</th></tr></thead>
            <tbody>
                @foreach (var c in _courses)
                {
                    <tr>
                        <td><div class="fw-600">@c.Title</div><div class="text-muted fs-sm">@c.CategoryName</div></td>
                        <td><span class="badge badge-info">@c.LessonCount ур.</span></td>
                        <td>
                            <div class="d-flex align-center gap-1">
                                @for (var i = 1; i <= 5; i++) {
                                    <i class="bi @(i <= Math.Round(c.AverageRating) ? "bi-star-fill" : "bi-star")" style="font-size:0.8rem;color:var(--warning)"></i>
                                }
                                <span class="text-muted fs-sm ms-1">@c.AverageRating.ToString("F1")</span>
                            </div>
                        </td>
                        <td class="text-primary fw-600">@c.Price.ToString("C")</td>
                        <td><span class="badge @(c.IsPublished ? "badge-success" : "badge-warning")">@(c.IsPublished ? "Опубликован" : "Черновик")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {

    List<GetCourseDto> _courses = new();

    bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetCoursesAsync();

        var all = r?.Data ?? new List<GetCourseDto>();

        _courses = all
            .Where(c => c.InstructorName == Api.CurrentUser?.FullName)
            .ToList();

        _loading = false;
    }
}
